{
  "id": "iswc",
  "acronym": "ISWC",
  "name": "International Semantic Web Conference",
  "type": "conference",
  "fields": [
    "column-type-annotation",
    "semantic-table-interpretation",
    "semantic-dependency-modeling",
    "semantic-data-management"
  ],
  "topics": [
    "Column Type Annotation",
    "Semantic Table Interpretation",
    "Semantic Dependency Modeling (data and language)",
    "Semantic Data Management"
  ],
  "homepage": "https://iswc2026.semanticweb.org/",
  "submission": "cfp",
  "cfp": {
    "adapter": "declarative",
    "url": "https://iswc2026.semanticweb.org/#/calls/research",
    "allowedHosts": [
      "iswc2026.semanticweb.org"
    ],
    "edition": {
      "year": 2026,
      "label": "ISWC 2026"
    },
    "timezone": {
      "label": "AoE",
      "time": "23:59"
    },
    "rounds": [
      {
        "id": "research",
        "label": {
          "ko": "연구 트랙",
          "en": "Research track"
        },
        "track": "full",
        "milestones": [
          {
            "type": "abstract",
            "pattern": "Abstract submission due\\s+b\\s*{{DATE}}"
          },
          {
            "type": "paper",
            "pattern": "Full paper submission due\\s+b\\s*{{DATE}}"
          },
          {
            "type": "notification",
            "pattern": "Notifications\\s+b\\s*{{DATE}}"
          },
          {
            "type": "camera-ready",
            "pattern": "Camera-ready papers due\\s+b\\s*{{DATE}}"
          }
        ]
      }
    ],
    "source": {
      "format": "javascript-strings",
      "follow": [
        "<script\\b[^>]*\\bsrc=\"([^\"]+)\"",
        "\"(\\./Research-[^\"]+\\.js)\""
      ]
    },
    "guards": [
      "All deadlines are\\s+b\\s+23:59 AoE"
    ]
  },
  "note": {
    "ko": "공식 페이지가 참조하는 연구 트랙 모듈을 매번 발견하고 정적 문자열에서 마감을 자동 추출합니다. 페이지 코드를 실행하지 않습니다.",
    "en": "Automatically discovers the official research module and extracts deadlines from static strings without executing page code."
  }
}
